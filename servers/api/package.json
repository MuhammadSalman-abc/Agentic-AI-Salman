{
  "name": "@workspace/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test:load": "tsx --test integrations/mongodb/load/planning.load.test.ts",
    "test": "tsx --test features/health/tests/*.test.ts features/planning/tests/*.test.ts tests/environment.test.ts tests/http-boundaries.test.ts tests/llm-provider.test.ts tests/mongodb.test.ts integrations/mongodb/tests/*.test.ts tests/shutdown.test.ts tests/rate-limit.test.ts",
    "lint": "eslint \"**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/logging": "workspace:*",
    "@workspace/types": "workspace:*",
    "dotenv": "^17.2.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "groq-sdk": "^1.6.0",
    "mongoose": "^9.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/tsconfig": "workspace:*",
    "eslint": "9.39.5",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
